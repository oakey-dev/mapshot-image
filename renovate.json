{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "abandonmentThreshold": "2 years",
  "packageRules": [
    {
      "matchDatasources": ["deb"],
      "separateMultipleMajor": false,
      "groupName": "packages",
      "commitBodyTable": true,
      "registryUrls": [
        "https://deb.debian.org/debian?suite=Debian13.7&components=main,contrib,non-free&binaryArch=amd64"
      ]
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchDatasources": ["docker"],
      "groupName": "packages"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchDatasources": ["docker"],
      "groupName": "packages",
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Debian suite version in registry URL",
      "fileMatch": ["^renovate\\.json$"],
      "matchStrings": [
        "\"registryUrls\"\\s*:\\s*\\[\\s*\"https://deb\\.debian\\.org/debian\\?suite=Debian(?<currentValue>(?<major>\\d+)\\.(?<minor>\\d+))"
      ],
      "currentValueTemplate": "{{{currentValue}}}",
      "datasourceTemplate": "docker",
      "depNameTemplate": "debian",
      "versioningTemplate": "regex:(?<major>\\d+)\\.(?<minor>\\d+)",
      "autoReplaceStringTemplate": "\"registryUrls\": [\n        \"https://deb.debian.org/debian?suite=Debian{{{newMajor}}}.{{{newMinor}}}&components=main,contrib,non-free&binaryArch=amd64\""
    }
  ],
  "maxMajorIncrement": 0,
  "osvVulnerabilityAlerts": true,
  "separateMultipleMajor": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "reviewersFromCodeOwners": true
}
